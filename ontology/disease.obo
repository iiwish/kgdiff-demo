property_value: http://purl.org/dc/elements/1.1/title "Mini Human Disease Ontology" xsd:string
property_value: http://purl.org/dc/terms/license https://creativecommons.org/publicdomain/zero/1.0/
remark: The Mini Human Disease Ontology (MHD) is a small teaching ontology written for the kgdiff examples. Identifiers are fictional; cross-references point to real vocabularies for realism and are not curated for clinical use.
remark: Release 2026-09-01.

[Term]
id: MHD:0000001
name: disease
namespace: disease
def: "A disposition to undergo pathological processes that exists in an organism because of one or more disorders in that organism." [MHD:curators]
subset: mhd_slim
xref: DOID:4

[Term]
id: MHD:0000002
name: disease of anatomical entity
namespace: disease
def: "A disease that manifests in a defined anatomical structure." [MHD:curators]
subset: mhd_slim
xref: DOID:7
is_a: MHD:0000001 ! disease

[Term]
id: MHD:0000003
name: infectious disease
namespace: disease
def: "A disease resulting from the presence and activity of a microbial, viral, fungal or parasitic agent." [MHD:curators]
subset: mhd_slim
xref: DOID:0050117
is_a: MHD:0000001 ! disease

[Term]
id: MHD:0000004
name: disease of cellular proliferation
namespace: disease
def: "A disease characterized by abnormally rapid cell division." [MHD:curators]
subset: mhd_slim
xref: DOID:14566
is_a: MHD:0000001 ! disease

[Term]
id: MHD:0000005
name: disease of metabolism
namespace: disease
def: "A disease that involves errors in metabolic processes of building or degradation of molecules." [MHD:curators]
subset: mhd_slim
xref: DOID:0014667
is_a: MHD:0000001 ! disease

